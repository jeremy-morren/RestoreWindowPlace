<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- xunit.v3 needs net8.0 or later on the modern side; the library's net7.0-windows assets serve it. -->
        <TargetFrameworks>net8.0-windows;net472</TargetFrameworks>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.1" />
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.1" />
        <PackageReference Include="FluentAssertions" Version="8.11.0" />
        <ProjectReference Include="..\RestoreWindowPosition\RestoreWindowPosition.csproj" />
    </ItemGroup>

</Project>
