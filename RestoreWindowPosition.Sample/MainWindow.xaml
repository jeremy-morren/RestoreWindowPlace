<Window x:Class="RestoreWindowPosition.Sample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RestoreWindowPosition" 
        Height="360" Width="560">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" 
                    Orientation="Horizontal" 
                    Margin="0,12,0,0">
            <Button x:Name="OpenTool" 
                    Content="Open tool window"
                    Padding="12,4" 
                    Click="OpenTool_Click" />
            <Button x:Name="SaveNow" 
                    Content="Save now" 
                    Padding="12,4" 
                    Margin="8,0,0,0" 
                    Click="SaveNow_Click" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" 
                   TextWrapping="Wrap" 
                   Margin="0,0,0,8">
            Move and resize this window, close it, and open it again: it comes back where you left it.
            Change your monitor arrangement and it remembers a separate position for that arrangement.
        </TextBlock>

        <TextBox x:Name="Layout" 
                 IsReadOnly="True" 
                 FontFamily="Consolas"
                 VerticalScrollBarVisibility="Auto" 
                 TextWrapping="NoWrap" />
    </DockPanel>
</Window>
